{
  // The published declarations: `dist/index.d.ts` and its siblings, beside
  // the one bundled `dist/index.js` that `bun run build` writes.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
